{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://recupreacaodeleadsalianca.vercel.app/api/app/v1"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://recupreacaodeleadsalianca.vercel.app/api/app/v1"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://recupreacaodeleadsalianca.vercel.app/api/app/v1"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "PREENCHER_ID_DO_APP_NO_APP_STORE_CONNECT"
      },
      "android": {
        "serviceAccountKeyPath": "./google-play-service-account.json",
        "track": "internal"
      }
    }
  }
}
