{
  "expo": {
    "name": "Aliança Brasil",
    "slug": "alianca-associado",
    "scheme": "alianca",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0E7A84",
    "ios": {
      "bundleIdentifier": "br.com.aliancabrasil.associado",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "A câmera é usada para fotografar documentos e o veículo que você manda para a Aliança.",
        "NSPhotoLibraryUsageDescription": "A galeria é usada para escolher fotos de documentos e do veículo que você manda para a Aliança.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": []
      }
    },
    "android": {
      "package": "br.com.aliancabrasil.associado",
      "adaptiveIcon": {
        "backgroundColor": "#0E7A84",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "blockedPermissions": [
        "android.permission.WRITE_SETTINGS",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "com.google.android.gms.permission.AD_ID"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-sharing",
      "expo-web-browser",
      "expo-font",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#0E7A84",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0D5259"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "A galeria é usada para escolher fotos de documentos e do veículo que você manda para a Aliança.",
          "cameraPermission": "A câmera é usada para fotografar documentos e o veículo que você manda para a Aliança.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
